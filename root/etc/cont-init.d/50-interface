#!/usr/bin/with-contenv bash

if [ -z "$INTERFACE" ]; then
SET_INTERFACE="eth0"
else
SET_INTERFACE=$INTERFACE
fi

/usr/local/openvpn_as/scripts/confdba -mk "admin_ui.https.ip_address" -v "$SET_INTERFACE" || echo "confdba a eșuat pentru admin_ui.https.ip_address"
/usr/local/openvpn_as/scripts/confdba -mk "cs.https.ip_address" -v "$SET_INTERFACE" || echo "confdba a eșuat pentru cs.https.ip_address"
/usr/local/openvpn_as/scripts/confdba -mk "vpn.daemon.0.listen.ip_address" -v "$SET_INTERFACE" || echo "confdba a eșuat pentru vpn.daemon.0.listen.ip_address"
/usr/local/openvpn_as/scripts/confdba -mk "vpn.daemon.0.server.ip_address" -v "$SET_INTERFACE" || echo "confdba a eșuat pentru vpn.daemon.0.server.ip_address"

